# Paczka Explorer - Integrated Configuration
# This .env file is used by both backend (Node.js) and frontend (Vite)

# ============ BACKEND SERVER ============

# Port for the Express backend server
PORT=8081

# Directory containing the course materials
# Relative to project root or absolute path
FILES_ROOT=../../paczka

# Temporary directory for uploads and zip operations
TEMP_DIR=temp

# Path to the full-text search index
INDEX_FILE=data/INDEKS.csv
INDEX_DIR_FILE=data/INDEKS_DIR.csv
METADATA_FILE=data/INDEKS_DIR.csv

# Path to SQLite database with file metadata
# (generated by metadata-generator)
# METADATA_DB_PATH=paczka_meta/metadata.sqlite

# ============ AUTHENTICATION & SECURITY ============

# Admin password for accessing management features
ADMIN_PASSWORD=admin123

# Service tokens for API access (comma-separated)
# Leave empty to disable token auth
SERVICE_TOKENS=

# Maximum upload size in MB
MAX_UPLOAD_MB=10

# CORS origin(s) for frontend requests (comma-separated)
# Use * to allow all origins (development only!)
CORS_ORIGIN=*

# ============ RATE LIMITING ============

# Rate limit window in milliseconds
RATE_LIMIT_WINDOW_MS=60000

# Maximum requests per window for general API
RATE_LIMIT_MAX_REQUESTS=100

# Maximum upload requests per window
RATE_LIMIT_UPLOAD_MAX=10

# Maximum login attempts per window
RATE_LIMIT_LOGIN_MAX=5

# ============ EXTERNAL SERVICES ============

# Discord webhook URL for notifications
DISCORD_WEBHOOK_URL=

# GitHub integration for pull requests
GITHUB_PR_URL=
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BASE_BRANCH=

# ============ FRONTEND (Vite) ============

# Backend API URL for frontend requests
# In development, can be relative (handled by vite proxy)
# In production, should be absolute URL to backend
VITE_API_BASE=

# URL to paczka-anki viewer (for .apkg preview iframe)
VITE_ANKI_VIEWER_URL=http://localhost:5173
